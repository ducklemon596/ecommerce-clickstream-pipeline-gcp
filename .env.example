# Copy to .env (never commit it) and load with: set -a && . ./.env && set +a
# Quote the value: an unquoted '&' would background the shell command.
# On the VM, MongoDB listens on 127.0.0.1:27017; from a workstation, use the SSH tunnel port (e.g. 27018).
MONGODB_URI='mongodb://<user>:<password>@127.0.0.1:27017/?authSource=admin&directConnection=true'

# export-avro only: secret HMAC key for email, device ID and IP (hex, >= 32 bytes).
# Generate once with: python -c 'import secrets; print(secrets.token_hex(32))'
# Keep it in a secret store: every export must use the same key so hashes join.
GLAMIRA_PII_HASH_KEY=
