{
  "type": "record",
  "name": "Event",
  "namespace": "glamira.raw",
  "doc": "One row per tracking event (27 event types) from countly.summary.",
  "fields": [
    {
      "name": "_id",
      "doc": "Event ID: source ObjectId as 24 hex chars",
      "type": "string"
    },
    {
      "name": "collection",
      "doc": "Event type, e.g. view_product_detail",
      "type": "string"
    },
    {
      "name": "time_stamp",
      "doc": "Event time (UTC) from Unix seconds",
      "type": {
        "type": "long",
        "logicalType": "timestamp-micros"
      }
    },
    {
      "name": "api_version",
      "doc": "Tracker API version",
      "type": "string"
    },
    {
      "name": "store_id",
      "doc": "Glamira store ID (digits)",
      "type": "string"
    },
    {
      "name": "current_url",
      "doc": "Page URL",
      "type": "string"
    },
    {
      "name": "referrer_url",
      "doc": "Referrer URL; '' for direct entries",
      "type": "string"
    },
    {
      "name": "ip_hash",
      "doc": "HMAC-SHA256 of the normalized client IP; joins ip_locations.ip_hash",
      "type": "string"
    },
    {
      "name": "device_id_hash",
      "doc": "HMAC-SHA256 of the device ID",
      "type": "string"
    },
    {
      "name": "user_id_hash",
      "doc": "HMAC-SHA256 of the customer ID; '' for anonymous visits (95.19%)",
      "type": "string"
    },
    {
      "name": "user_agent",
      "doc": "Browser user agent",
      "type": "string"
    },
    {
      "name": "local_time",
      "doc": "Client local time as sent, e.g. '2020-05-20 3:6:40'",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "resolution",
      "doc": "Screen resolution as sent",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "email_hash",
      "doc": "HMAC-SHA256 of the trimmed, lower-cased email; '' when not given",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "show_recommendation",
      "doc": "'true'/'false' as sent; a few malformed values",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "product_id",
      "doc": "Product of a product event",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "viewing_product_id",
      "doc": "Product page on which a recommendation was shown",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "recommendation_product_id",
      "doc": "Recommended product",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "recommendation_clicked_position",
      "doc": "Clicked slot (always 0 observed)",
      "type": [
        "null",
        "long"
      ],
      "default": null
    },
    {
      "name": "recommendation_product_position",
      "doc": "Slot of the recommended product; int or string in the source",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "recommendation",
      "doc": "Recommendation flag (only false observed)",
      "type": [
        "null",
        "boolean"
      ],
      "default": null
    },
    {
      "name": "utm_source",
      "doc": "Campaign source; source false becomes 'false'",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "utm_medium",
      "doc": "Campaign medium; source false becomes 'false'",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "cat_id",
      "doc": "Category ID of a listing page",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "collect_id",
      "doc": "Collection ID of a listing page",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "key_search",
      "doc": "Search text (search_box_action)",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "price",
      "doc": "Locale-formatted price (add_to_cart_action)",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "currency",
      "doc": "Currency symbol (add_to_cart_action)",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "is_paypal",
      "doc": "PayPal express checkout (only true observed)",
      "type": [
        "null",
        "boolean"
      ],
      "default": null
    },
    {
      "name": "order_id",
      "doc": "Order number (checkout_success); '' in checkout",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "option",
      "doc": "Chosen product options: the array form of the source 'option'",
      "type": {
        "type": "array",
        "items": {
          "type": "record",
          "name": "OptionItem",
          "fields": [
            {
              "name": "option_label",
              "doc": "Option name, e.g. alloy, diamond, stone/diamonds",
              "type": [
                "null",
                "string"
              ],
              "default": null
            },
            {
              "name": "option_id",
              "doc": "Product option ID; joins product_option_values.option_id",
              "type": [
                "null",
                "string"
              ],
              "default": null
            },
            {
              "name": "value_label",
              "doc": "Selected value label",
              "type": [
                "null",
                "string"
              ],
              "default": null
            },
            {
              "name": "value_id",
              "doc": "Selected value ID; joins product_option_values.value_id",
              "type": [
                "null",
                "string"
              ],
              "default": null
            },
            {
              "name": "quality",
              "doc": "Stone quality code (select_product_option_quality only)",
              "type": [
                "null",
                "string"
              ],
              "default": null
            },
            {
              "name": "quality_label",
              "doc": "Stone quality label (select_product_option_quality only)",
              "type": [
                "null",
                "string"
              ],
              "default": null
            }
          ]
        }
      },
      "default": []
    },
    {
      "name": "option_filter",
      "doc": "Listing filter state: the object form of the source 'option'",
      "type": [
        "null",
        {
          "type": "record",
          "name": "OptionFilter",
          "fields": [
            {
              "name": "alloy",
              "doc": "Metal filter",
              "type": [
                "null",
                "string"
              ],
              "default": null
            },
            {
              "name": "diamond",
              "doc": "Stone filter",
              "type": [
                "null",
                "string"
              ],
              "default": null
            },
            {
              "name": "shapediamond",
              "doc": "Stone shape filter",
              "type": [
                "null",
                "string"
              ],
              "default": null
            },
            {
              "name": "stone",
              "doc": "Stone filter (view_all_recommend)",
              "type": [
                "null",
                "string"
              ],
              "default": null
            },
            {
              "name": "price",
              "doc": "Price filter (view_all_recommend)",
              "type": [
                "null",
                "string"
              ],
              "default": null
            },
            {
              "name": "finish",
              "doc": "Finish filter (view_all_recommend)",
              "type": [
                "null",
                "string"
              ],
              "default": null
            },
            {
              "name": "pearlcolor",
              "doc": "Pearl colour filter (view_all_recommend)",
              "type": [
                "null",
                "string"
              ],
              "default": null
            },
            {
              "name": "kollektion",
              "doc": "Collection filter; source key 'Kollektion'",
              "type": [
                "null",
                "string"
              ],
              "default": null
            },
            {
              "name": "kollektion_id",
              "doc": "Collection ID filter (view_all_recommend)",
              "type": [
                "null",
                "string"
              ],
              "default": null
            },
            {
              "name": "category_id",
              "doc": "Category filter; source key 'category id'",
              "type": [
                "null",
                "string"
              ],
              "default": null
            }
          ]
        }
      ],
      "default": null
    },
    {
      "name": "cart_products",
      "doc": "Cart lines (cart and checkout events)",
      "type": {
        "type": "array",
        "items": {
          "type": "record",
          "name": "CartProduct",
          "fields": [
            {
              "name": "product_id",
              "doc": "Product ID; int in the source",
              "type": [
                "null",
                "string"
              ],
              "default": null
            },
            {
              "name": "amount",
              "doc": "Quantity (checkout, checkout_success); -1 to 9,999 observed",
              "type": [
                "null",
                "long"
              ],
              "default": null
            },
            {
              "name": "price",
              "doc": "Locale-formatted unit price (checkout_success), e.g. '55,00'",
              "type": [
                "null",
                "string"
              ],
              "default": null
            },
            {
              "name": "currency",
              "doc": "Currency symbol (checkout_success), e.g. '€'",
              "type": [
                "null",
                "string"
              ],
              "default": null
            },
            {
              "name": "option",
              "doc": "Chosen options; the source string '' becomes an empty array",
              "type": {
                "type": "array",
                "items": {
                  "type": "record",
                  "name": "CartOption",
                  "fields": [
                    {
                      "name": "option_id",
                      "doc": "Option ID; int in the source",
                      "type": [
                        "null",
                        "string"
                      ],
                      "default": null
                    },
                    {
                      "name": "option_label",
                      "doc": "Option name",
                      "type": [
                        "null",
                        "string"
                      ],
                      "default": null
                    },
                    {
                      "name": "value_id",
                      "doc": "Value ID; int in the source",
                      "type": [
                        "null",
                        "string"
                      ],
                      "default": null
                    },
                    {
                      "name": "value_label",
                      "doc": "Selected value label",
                      "type": [
                        "null",
                        "string"
                      ],
                      "default": null
                    }
                  ]
                }
              },
              "default": []
            }
          ]
        }
      },
      "default": []
    }
  ]
}
