{
  "type": "record",
  "name": "ProductOptionValue",
  "namespace": "glamira.raw",
  "doc": "One row per (product, option, value) served by react_data: resolves event option/value IDs.",
  "fields": [
    {
      "name": "product_id",
      "doc": "Product ID",
      "type": "string"
    },
    {
      "name": "option_id",
      "doc": "Option ID; joins events option[].option_id",
      "type": "string"
    },
    {
      "name": "value_id",
      "doc": "Value ID; null for free-text options such as engraving",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "part_type",
      "doc": "Part, e.g. stone1, alloy",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "option_type",
      "doc": "alloy, stone, engraving_font, ...",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "option_title",
      "doc": "Option title in the store language",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "option_default_title",
      "doc": "Option default title",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "is_require",
      "doc": "Option is mandatory; source 0/1",
      "type": [
        "null",
        "boolean"
      ],
      "default": null
    },
    {
      "name": "sort_order",
      "doc": "Display order as served",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "value_sku",
      "doc": "Value token used in product URLs",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "value_title",
      "doc": "Value title",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "value_default_title",
      "doc": "Value default title",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "value_store_title",
      "doc": "Value title in the store",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "is_default",
      "doc": "Default value; source bool or 0",
      "type": [
        "null",
        "boolean"
      ],
      "default": null
    },
    {
      "name": "value_price",
      "doc": "Price surcharge of the value",
      "type": [
        "null",
        {
          "type": "bytes",
          "logicalType": "decimal",
          "precision": 38,
          "scale": 9
        }
      ],
      "default": null
    },
    {
      "name": "price_type",
      "doc": "fixed, percent or abs",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "run_id",
      "doc": "Crawl run ID",
      "type": "string"
    },
    {
      "name": "crawled_at",
      "doc": "Crawl time (UTC)",
      "type": {
        "type": "long",
        "logicalType": "timestamp-micros"
      }
    }
  ]
}
